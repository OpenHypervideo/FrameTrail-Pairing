# /etc/systemd/system/frametrail-pairing.service
#
# The FrameTrail pairing broker, on 127.0.0.1:8787 behind Plesk's web server (deploy/apache-directives.conf, or deploy/nginx-directives.conf with Plesk's nginx). Its configuration is in /etc/frametrail-pairing/broker.env (deploy/broker.env.example).
#
#   systemctl daemon-reload && systemctl enable --now frametrail-pairing
#   journalctl -u frametrail-pairing -f

[Unit]
Description=FrameTrail pairing broker (contract v1)
Documentation=https://github.com/OpenHypervideo/FrameTrail-Pairing
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Node 20 or later: Plesk's Node.js 24 (ls /opt/plesk/node lists the versions Plesk has; with NodeSource it is /usr/bin/node).
ExecStart=/opt/plesk/node/24/bin/node /opt/frametrail-pairing/src/pairing-broker.mjs
EnvironmentFile=/etc/frametrail-pairing/broker.env
Restart=on-failure
RestartSec=2s
# No user of its own to create and keep: systemd makes one for each start.
DynamicUser=yes
UMask=0077

# The broker reads its code, listens on 127.0.0.1 and asks Cloudflare's API over https; nothing else.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# V8 compiles JavaScript to machine code while it runs, so MemoryDenyWriteExecute stays off.
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
