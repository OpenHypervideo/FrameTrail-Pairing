# /etc/frametrail-pairing/broker.env: the broker's configuration (node src/pairing-broker.mjs --help lists every option). It holds the Cloudflare API token: install -m 600 -o root -g root broker.env.example /etc/frametrail-pairing/broker.env

# Behind Plesk's web server: listen on loopback only, and trust the client address the web server forwards.
HOST=127.0.0.1
PORT=8787
TRUSTED_PROXIES=127.0.0.1,::1

# STUN for every page. Cloudflare hands it out with its TURN as well; set here, it stays when Cloudflare's API cannot be reached.
STUN_URLS=stun:stun.cloudflare.com:3478

# Cloudflare Realtime TURN (dash.cloudflare.com → Realtime → TURN Server → Create): the key's id and its API token.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Lifetime of TURN credentials, in seconds (24 h). The player fetches /ice once, when pairing starts, and opens relays with those credentials for every phone that joins while its QR code is up; Cloudflare ends a relayed session when its credentials expire. 24 h covers a school day; Cloudflare allows up to 48 h.
TURN_TTL=86400

# Only pages of these origins get TURN credentials (separated by commas); STUN goes to every page. A companion page on another origin (pairingCompanionURL) must be listed as well.
ALLOWED_ORIGINS=https://www.example.org

# Per client (an IPv4 address, or an IPv6 /64): requests a minute, and at once. A class pairing behind one address makes about 7 requests per phone, the player one a second.
#RATE_LIMIT=1200
#RATE_BURST=600

# all | info (all but the routine polls) | warn | off
#LOG_LEVEL=info
